# CampusNet backend configuration (safe localhost defaults).
# Copy to .env and adjust as needed. Never commit a real .env.

# SQLite database (project-local).
DATABASE_URL=sqlite:///./campusnet.db

# RADIUS event log consumed by the ingestion worker.
#   Dev / fixture replay (default):
RADIUS_EVENT_LOG=./data/radius-events.jsonl
#   Live FreeRADIUS integration — point at the host log instead:
#   RADIUS_EVENT_LOG=/var/log/campusnet/radius-events.jsonl

# systemd unit name used for the RADIUS health check (Fedora: radiusd).
RADIUS_SERVICE_NAME=radiusd

# Ingestion worker poll interval (seconds). Keep >= 1 for a gentle poll.
POLL_INTERVAL_SECONDS=2

# CORS: the local frontend origin allowed to call this API.
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Default stats window (hours).
DEFAULT_WINDOW_HOURS=24
